/**
 * Cloud Storage Security Rules for LegacyBot.
 * Audio files: gs://{bucket}/{familyId}/{dossierId}/{sessionId}.webm
 *
 * Access is restricted to authenticated users. Fine-grained family membership
 * checks are enforced at the Firestore level (session docs are only readable
 * by family members, so the audioUrl is only accessible to them).
 */
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{familyId}/{dossierId}/{sessionId} {
      allow read, write: if request.auth != null;
    }
  }
}
