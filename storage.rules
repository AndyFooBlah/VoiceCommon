/**
 * Cloud Storage Security Rules for LegacyBot.
 *
 * Paths:
 *   Audio:        {familyId}/{dossierId}/{sessionId}.webm
 *   Media:        {familyId}/{dossierId}/media/{fileId}
 *   Clips:        {familyId}/{dossierId}/clips/{clipId}.webm
 *   Prompt photos: {familyId}/{dossierId}/promptPhotos/{photoId}
 *
 * Access is restricted to authenticated users. Fine-grained family membership
 * checks are enforced at the Firestore level.
 */
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{familyId}/{dossierId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
