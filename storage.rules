/**
 * Cloud Storage Security Rules for VoiceCommon.
 *
 * Path convention:
 *   sessions/{userId}/{sessionId}.webm   — archived session audio
 *
 * Access: authenticated users may read and write their own session audio.
 */
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sessions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
