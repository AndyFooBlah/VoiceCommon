# ⚠️ LOCAL DEV ONLY — NEVER DEPLOY THIS PROTOTYPE.
# Every VITE_* value below is compiled into the browser JavaScript bundle and
# is trivially extractable by anyone who can load the page. This is the exact
# key-leak pattern the VoiceCommon library forbids; it is tolerated here ONLY
# because this prototype runs solely on your own machine with dev/test keys.
# Do not host or production-build this prototype, and do not use production keys.
#
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and must never be committed.

# --- Gemini (used by the frontend for LLM calls) ---
# Get your key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# --- Gradium (used by both the proxy server and the frontend TTS call) ---
# Get your key at https://gradium.ai
VITE_GRADIUM_API_KEY=

# --- Gradium TTS voice ---
# List your available voices by calling GET https://us.api.gradium.ai/api/voices
# with your API key. Paste one of the returned voice IDs here.
# If left blank, the prototype will try "default" but this may not be valid.
VITE_GRADIUM_VOICE_ID=
