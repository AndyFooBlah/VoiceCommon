{
  "name": "@andyfooblah/voice-common",
  "version": "0.15.0",
  "description": "Reusable framework for building voice AI web applications powered by Google Gemini Live and Firebase.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyFooBlah/VoiceCommon.git"
  },
  "homepage": "https://github.com/AndyFooBlah/VoiceCommon#readme",
  "bugs": {
    "url": "https://github.com/AndyFooBlah/VoiceCommon/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/lib.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-for-secrets.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/check-bundle-for-secrets.mjs",
    "check:bundle": "node scripts/check-bundle-for-secrets.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "vite build && firebase deploy",
    "deploy:preview": "vite build && firebase hosting:channel:deploy preview"
  },
  "peerDependencies": {
    "@google/genai": "^2.0.0",
    "firebase": "^12.0.0 || ^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@andyfooblah/knowledge-common": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase": "^13.1.0",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@andyfooblah/knowledge-common": {
      "firebase": "$firebase"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/project-service": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "$typescript"
    }
  }
}
