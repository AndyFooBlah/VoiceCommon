{
  "name": "@andyfooblah/voice-common",
  "version": "0.6.0",
  "description": "Reusable framework for building voice AI web applications powered by Google Gemini Live and Firebase.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/lib.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-for-secrets.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/check-bundle-for-secrets.mjs",
    "check:bundle": "node scripts/check-bundle-for-secrets.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wikipedia": "npx tsx scripts/test-wikipedia-rag.ts",
    "deploy": "vite build && firebase deploy",
    "deploy:preview": "vite build && firebase hosting:channel:deploy preview"
  },
  "peerDependencies": {
    "@google/genai": ">=1.0.0",
    "firebase": ">=12.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@andyfooblah/knowledge-common": "file:../knowledgecommon",
    "@google/genai": ">=1.0.0",
    "firebase": ">=12.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.0.18"
  }
}
