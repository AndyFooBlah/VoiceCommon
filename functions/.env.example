# Cloud Functions environment variables for the VoiceCommon demo app.
# Copy this file to functions/.env and fill in your values.
# Never commit functions/.env — it is gitignored.
#
# Secrets are NOT stored in this file. Set them via Firebase Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY

# Base URL of the deployed frontend (available in onSessionCompleted for
# constructing deep links in any post-session processing you add).
APP_URL=https://your-project.web.app
