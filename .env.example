# Firebase configuration — get these from the Firebase Console
# (Project Settings > General > Your apps > Config)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Gemini API key — get this from Google AI Studio (https://aistudio.google.com)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Google Maps API key — used for place search, distance, and weather tools
# Enable in Google Cloud Console: Geocoding API, Maps Weather API
# Add HTTP referrer restrictions for your domain in production
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
