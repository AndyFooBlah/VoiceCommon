# Firebase configuration — get these from the Firebase Console
# (Project Settings > General > Your apps > Config)
#
# Public by design — security comes from Firestore Rules + GCP API key
# restrictions, NOT from keeping these out of the bundle.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ─────────────────────────────────────────────────────────────────────────
# DO NOT add VITE_GEMINI_API_KEY (or any other secret API key) to this file.
# Anything VITE_* prefixed is bundled into the browser JS and is trivially
# extractable. VoiceCommon never accepts a long-lived Gemini key in browser
# config — the only sanctioned entry point is the `tokenProvider` callback
# in initializeVoiceCommon(...), which delegates to a server-side broker
# that holds GEMINI_API_KEY in (e.g.) Firebase Secret Manager.
#
# The demo app in src/index.tsx ships a placeholder tokenProvider that
# throws an explanatory error. To run the demo end-to-end you'll need to
# stand up your own Cloud Function that mints ephemeral tokens via Gemini's
# authTokens.create API.
# ─────────────────────────────────────────────────────────────────────────
